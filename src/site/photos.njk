---
permalink: /photos/
---
{% set photos = archiveGallery.items %}
<div class="mh-gal">
  {% if photos.length %}
  <p class="mh-gal-intro">Every photograph, as uploaded. Click one to change its effect; keep clicking to cycle through them.</p>
  <div class="mh-gal-grid">
  {% for p in photos %}
    <figure class="mh-gal-tile" tabindex="0" role="button" data-start="{{ p.effect }}" aria-label="{{ p.name }}: click to change the effect">
      <img src="{{ p.src }}" alt="Photograph, as uploaded">
      <figcaption class="mh-gal-cap">as uploaded</figcaption>
    </figure>
  {% endfor %}
  </div>
  {% else %}
  <p class="mh-gal-intro">No photographs yet. Upload some from Obsidian and they appear here.</p>
  {% endif %}
</div>
