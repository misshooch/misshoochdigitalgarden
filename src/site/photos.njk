---
permalink: /photos/
---
{% set photos = archiveGallery.items %}
{% set effects = ["halftone", "phosphor", "cyber", "pixel", "code"] %}
<div class="mh-gal">
  {% if photos.length %}
  <p class="mh-gal-intro">Click any photograph to see the original underneath.</p>
  {% for p in photos %}
    <section class="mh-gal-set">
      <h2>{{ p.name }}</h2>
      <div class="mh-gal-row">
        <div class="mh-gal-cell"><img src="{{ p.src }}" alt="{{ p.name }}, as uploaded"><span class="mh-gal-cap">as uploaded</span></div>
        {% if p.effect %}
          <div class="mh-gal-cell"><img src="{{ p.src }}" alt="{{ p.effect }}"><span class="mh-gal-cap">|{{ p.effect }}</span></div>
        {% else %}
          {% for e in effects %}
            <div class="mh-gal-cell"><img src="{{ p.src }}" alt="{{ e }}"><span class="mh-gal-cap">|{{ e }}</span></div>
          {% endfor %}
        {% endif %}
      </div>
    </section>
  {% endfor %}
  {% else %}
  <p class="mh-gal-intro">No photographs yet. Add some in src/site/img/photos/ or list links in src/site/photos.txt.</p>
  {% endif %}
</div>
