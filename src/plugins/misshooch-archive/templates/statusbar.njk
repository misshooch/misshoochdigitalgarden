<div class="mh-fxlayer" aria-hidden="true"></div>
<div class="mh-status" role="region" aria-label="Archive status bar">
  <span class="mh-s-name">{{ meta.siteName }}</span>
  <span class="mh-s-tc" id="mh-tc" aria-hidden="true">00:00:00:00</span>
  <div class="mh-player" id="mh-player" data-playlist="{{ pluginSettings.playlist }}{% if pluginSettings.playlist and archiveMusic.playlist %}; {% endif %}{{ archiveMusic.playlist }}">
    <button type="button" data-mh-prev aria-label="Previous track">&#9198;</button>
    <button type="button" data-mh-play aria-label="Play or pause" aria-pressed="false">&#9654;</button>
    <button type="button" data-mh-next aria-label="Next track">&#9197;</button>
    <span class="mh-p-title" id="mh-p-title">no track</span>
    <canvas id="mh-eq" width="96" height="22" aria-hidden="true"></canvas>
    <label class="mh-vol">vol <input id="mh-vol" type="range" min="0" max="1" step="0.05" value="0.25" aria-label="Volume"></label>
  </div>
  <button type="button" class="mh-s-calm" data-mh-calm aria-pressed="false" title="Turn off scanlines, grain and motion">calm: off</button>
</div>
